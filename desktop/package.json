{
  "name": "forgeai-desktop",
  "version": "0.1.0",
  "description": "ForgeAI Windows desktop wrapper",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:desktop": "electron-builder --win nsis zip",
    "dist:win": "npm run build:desktop"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.forgeai.desktop",
    "productName": "ForgeAI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "ForgeAI-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ForgeAI"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
