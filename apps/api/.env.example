# Server-side credentials only. Never place these in apps/web/.env.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables automatic live search for time-sensitive questions.
TAVILY_API_KEY=your-tavily-api-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-supabase-secret-key

# Comma-separated exact origins. Add your deployed web origin as needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,forgeai://app
